{
  "name": "ifczero",
  "version": "0.0.3",
  "description": "IFC authoring, geometry and serialization library for the web, powered by IfcOpenShell.",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./parse": "./dist/parse/index.js",
    "./geom": "./dist/geom/index.js",
    "./serializers": "./dist/serializers/index.js",
    "./util": "./dist/util/index.js",
    "./wasm/*": "./dist/wasm/*"
  },
  "scripts": {
    "codegen": "tsx codegen/generate-bindings.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-wasm.mjs",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/theseyan/ifczero.git"
  },
  "keywords": [
    "ifc",
    "bim",
    "wasm",
    "webassembly",
    "ifcopenshell"
  ]
}
